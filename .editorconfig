# EditorConfig for Markdown files
[*.md]
# Use spaces, not tabs — aligns with MD010: no-hard-tabs
indent_style = space
# Typical indentation is 2 spaces for lists/codeblocks etc
indent_size = 2

# Trim trailing whitespace — aligns with MD009: no-trailing-spaces
trim_trailing_whitespace = true

# Ensure newline at end of file — aligns with MD047: single-trailing-newline
insert_final_newline = true

# Use Unix line endings (LF) — good general practice
end_of_line = lf